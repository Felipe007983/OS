{
  "installCommand": "cd client && npm install --include=dev",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "VITE_API_URL": "https://server-xi-seven-17.vercel.app/api"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
