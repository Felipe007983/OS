# Supabase — Connection Pooling (porta 6543, modo Transaction)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — Conexão direta (porta 5432, para migrations/db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# URL do frontend na Vercel (ex: https://seu-app.vercel.app)
APP_BASE_URL="https://seu-app.vercel.app"

PORT=3001
NODE_ENV=production
